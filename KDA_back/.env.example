# Copia este archivo a .env.development.local (desarrollo) o configura estas
# variables en el panel de tu proveedor de despliegue (producción).

# Puerto del servidor. En producción muchos proveedores (Render) lo inyectan solos.
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Base de datos SQLite (archivo local). En despliegue puede quedar igual.
DATABASE_URL="file:./dev.db"

# Autenticación JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="1d"
