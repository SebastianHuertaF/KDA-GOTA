# Copia este archivo a .env.development.local (desarrollo) o configura estas
# variables en el panel de tu proveedor de despliegue (producción).

# Puerto del servidor. En producción muchos proveedores (Render) lo inyectan solos.
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Base de datos SQLite (archivo local). En despliegue puede quedar igual.
DATABASE_URL="file:./dev.db"

# Autenticación JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="1d"

# URL pública que se codifica DENTRO de los QR impresos. Debe ser absoluta y
# alcanzable desde un celular: "localhost" no existe para el teléfono que escanea.
# Para probar con el móvil en tu red local, usa la IP LAN de tu PC.
APP_URL="http://localhost:3000"

# Salt con el que se derivan los códigos QR. NO es un secreto (el formulario de
# reporte es público), pero sí tiene que ser ESTABLE: si lo cambias, todos los QR
# ya impresos y pegados en los bebederos dejan de resolver.
QR_SALT="kda-gota-qr"

# Cuenta inicial del panel de administración, creada por el seed. El registro
# público está cerrado: sin esto no hay forma de entrar al panel.
# ADMIN_PASSWORD no tiene valor por defecto a propósito (un default sería una
# puerta trasera conocida); si no la defines, el seed simplemente no crea la cuenta.
ADMIN_EMAIL="admin@pucp.edu.pe"
ADMIN_PASSWORD=""
